# =====================================================================
# AI-Based QA for Policy Documents - Environment Configuration
# Stack: Groq LLM + Qdrant Vector Database + FastEmbed
# =====================================================================

# 1. Sole LLM Provider: Groq (Ultra-fast inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# 2. Local FastEmbed Embeddings (No API Key Required, 384 dimensions)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# 3. Qdrant Vector Database Configuration
# ---------------------------------------------------------------------
# Option A: Qdrant Cloud Cluster (Set your URL and API Key)
# Example:
# QDRANT_URL=https://d3fad98e-81ba-4766-8af1-6778976dc234.us-east-2-0.aws.cloud.qdrant.io
# QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_URL=
QDRANT_API_KEY=

# Option B: Local Persistent Storage (Used automatically if QDRANT_URL is empty)
QDRANT_STORAGE_PATH=./qdrant_db
COLLECTION_NAME=sritr_university_policies

# 4. Chunking & Retrieval Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4

# 5. FastAPI Backend Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
